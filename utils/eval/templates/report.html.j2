<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if key_name %}{{ key_name }} 导出情况{% else %}Session 质检报告{% endif %}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
         font-size: 14px; color: #1a1a2e; background: #f4f6fb; }
  .page { max-width: 1200px; margin: 32px auto; padding: 0 20px 60px; }

  /* header */
  .report-header { background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
    color: #fff; border-radius: 10px; padding: 24px 32px; margin-bottom: 24px; }
  .report-header h1 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
  .report-header .meta { font-size: 12px; opacity: .8; line-height: 1.6; }
  .report-header .meta span { margin-right: 16px; }

  /* tabs — pure CSS */
  .tab-group { position: relative; }
  .tab-group input[type=radio] { display: none; }
  .tab-bar { display: flex; gap: 4px; margin-bottom: 20px; }
  .tab-bar label { padding: 8px 20px; border-radius: 8px 8px 0 0; cursor: pointer;
    font-size: 13px; font-weight: 600; background: #e2e8f0; color: #475569; transition: all .2s; }
  .tab-bar label:hover { background: #cbd5e1; }
  #tab-quality:checked ~ .tab-bar label[for=tab-quality],
  #tab-usage:checked ~ .tab-bar label[for=tab-usage],
  #tab-tools:checked ~ .tab-bar label[for=tab-tools] {
    background: #1d4ed8; color: #fff; }
  .tab-panel { display: none; }
  #tab-quality:checked ~ .panel-quality,
  #tab-usage:checked ~ .panel-usage,
  #tab-tools:checked ~ .panel-tools { display: block; }

  /* card */
  .card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.06);
          padding: 22px 26px; margin-bottom: 18px; }
  .card h2 { font-size: 15px; color: #1e40af; border-left: 4px solid #3b82f6;
             padding-left: 10px; margin-bottom: 14px; }
  .card h3 { font-size: 13px; color: #555; margin: 12px 0 8px; font-weight: 600; }

  /* KPI */
  .kpi-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .kpi { flex: 1 1 130px; background: #f0f5ff; border-radius: 8px;
         padding: 12px 14px; text-align: center; }
  .kpi .val { font-size: 24px; font-weight: 700; color: #1e40af; line-height: 1.2; }
  .kpi .lbl { font-size: 11px; color: #888; margin-top: 3px; }

  /* tables */
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { background: #1e40af; color: #fff; padding: 7px 10px; text-align: left; font-weight: 600; font-size: 12px; }
  th.r, td.r { text-align: right; }
  td { padding: 6px 10px; border-bottom: 1px solid #eef0f5; }
  tr:nth-child(even) td { background: #f7f9fd; }
  tr:hover td { background: #edf3fb; }

  /* bar chart */
  .bar-cell { display: flex; align-items: center; gap: 6px; }
  .bar-wrap { flex: 1; background: #e8edf5; border-radius: 3px; height: 10px; overflow: hidden; }
  .bar-fill  { height: 100%; background: linear-gradient(90deg, #3b82f6, #60a5fa);
               border-radius: 3px; transition: width .4s; }
  .bar-pct   { font-size: 11px; color: #666; min-width: 36px; text-align: right; }

  /* quality */
  .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
  .badge-ok   { background: #dcfce7; color: #166534; }
  .badge-err  { background: #fde8e8; color: #b91c1c; }
  .quality-summary { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .q-bar-wrap { flex: 1; min-width: 180px; }
  .q-bar-bg   { background: #e8edf5; border-radius: 4px; height: 14px; overflow: hidden; }
  .q-bar-ok   { background: #22c55e; height: 100%; border-radius: 4px 0 0 4px; }

  /* two-col grid */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }

  /* expandable dist rows */
  .dist-row { cursor: pointer; }
  .dist-row:hover td { background: #dbeafe !important; }
  .detail-row { display: none; }
  .detail-row.open { display: table-row; }
  .detail-row td { background: #f0f4ff; padding: 8px 14px; }
  .detail-row ul { margin: 0; padding: 0 0 0 16px; font-size: 12px; line-height: 1.8; max-height: 200px; overflow-y: auto; }
  .detail-row a { color: #2563eb; text-decoration: none; }
  .detail-row a:hover { text-decoration: underline; }

  code { background: #eef0f5; padding: 1px 5px; border-radius: 4px; font-family: monospace; font-size: 12px; }
</style>
</head>
<body>
<div class="page">

{# ---- macro: session list for expandable rows ---- #}
{% macro session_list(items, colspan=4) %}
{% if items %}
<tr class="detail-row"><td colspan="{{ colspan }}"><ul>
  {% for s in items[:200] %}<li><a href="/history?file={{ s.file }}{% if s.log_dir %}&log_dir={{ s.log_dir }}{% endif %}" target="_blank">{{ s.file or s.name }}</a></li>{% endfor %}
  {% if items|length > 200 %}<li style="color:#999">…还有 {{ items|length - 200 }} 个（已省略，避免报告过大）</li>{% endif %}
</ul></td></tr>
{% endif %}
{% endmacro %}

{# ---- macro: dist table ---- #}
{% macro dist_table(rows) %}
<table>
  <tr><th>区间</th><th class="r">数量</th><th class="r">占比</th><th style="min-width:140px">分布</th></tr>
  {% for row in rows %}
  <tr class="dist-row" onclick="toggleDetail(this)">
    <td>{{ row.label }}</td>
    <td class="r">{{ row.count }}</td>
    <td class="r">{{ row.pct }}%</td>
    <td><div class="bar-cell">
      <div class="bar-wrap"><div class="bar-fill" style="width:{{ row.pct }}%"></div></div>
      <span class="bar-pct">{{ row.pct }}%</span>
    </div></td>
  </tr>
  {{ session_list(row.sessions) }}
  {% endfor %}
</table>
{% endmacro %}

  <!-- header -->
  <div class="report-header">
    <h1>{% if key_name %}{{ key_name }} 导出情况{% else %}Session 质检报告{% endif %}</h1>
    <div class="meta">
      <span>生成时间：{{ generated_at }}</span>
      <span>总 session：{{ total }}</span>
      {% if obs_path %}<span>OBS：<code style="background:rgba(255,255,255,.15);color:#fff">{{ obs_path }}</code></span>{% endif %}
    </div>
  </div>

  {% if total and quality.fail_count * 100 // total >= 90 %}
  <div style="margin:12px 0;padding:12px 16px;background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;color:#92400e;font-size:.9rem;line-height:1.6">
    ⚠️ 本报告失败率异常偏高（{{ quality.fail_pct }}%）。若数据源为 new-api 且这批报告生成较早，
    可能是 OpenAI 格式响应的旧解析问题（正文被误判为空）已修复——
    请回<strong>导出页</strong>对该 key <strong>重新导出一次</strong>，即可得到正确的质量判定。
  </div>
  {% endif %}

  <div class="tab-group">
    <input type="radio" name="tabs" id="tab-quality" checked>
    <input type="radio" name="tabs" id="tab-usage">
    <input type="radio" name="tabs" id="tab-tools">
    <div class="tab-bar">
      <label for="tab-quality">质量评估</label>
      <label for="tab-usage">调用情况</label>
      <label for="tab-tools">模型工具</label>
    </div>

    <!-- ================================================================ -->
    <!-- TAB 1: 质量评估 -->
    <!-- ================================================================ -->
    <div class="tab-panel panel-quality">

      <div class="card">
        <h2>质量评估（任务完成状态）</h2>
        <div class="quality-summary">
          <div class="kpi" style="background:#dcfce7">
            <div class="val" style="color:#166534">{{ quality.ok_count }}</div>
            <div class="lbl">无问题（{{ quality.ok_pct }}%）</div>
          </div>
          <div class="kpi" style="background:#fde8e8">
            <div class="val" style="color:#b91c1c">{{ quality.fail_count }}</div>
            <div class="lbl">存在问题（{{ quality.fail_pct }}%）</div>
          </div>
          <div class="q-bar-wrap">
            <div style="font-size:12px;color:#666;margin-bottom:4px">质量通过率</div>
            <div class="q-bar-bg">
              <div class="q-bar-ok" style="width:{{ quality.ok_pct }}%"></div>
            </div>
            <div style="font-size:11px;color:#888;margin-top:3px">{{ quality.ok_pct }}% 无质量问题</div>
          </div>
        </div>
        {% if quality.has_fails %}
        <h3>错误类型分布</h3>
        <table>
          <tr><th>错误码</th><th>说明</th><th class="r">命中数</th><th class="r">占比</th><th style="min-width:140px">分布</th></tr>
          {% for e in quality.error_dist %}
          <tr class="dist-row" onclick="toggleDetail(this)">
            <td><span class="badge badge-err">{{ e.code }}</span></td>
            <td>{{ e.desc }}</td>
            <td class="r">{{ e.count }}</td>
            <td class="r">{{ e.pct }}%</td>
            <td><div class="bar-cell">
              <div class="bar-wrap"><div class="bar-fill" style="width:{{ e.pct }}%;background:linear-gradient(90deg,#ef4444,#f87171)"></div></div>
              <span class="bar-pct">{{ e.pct }}%</span>
            </div></td>
          </tr>
          {{ session_list(e.sessions, 5) }}
          {% endfor %}
        </table>
        {% endif %}
      </div>

      <div class="card">
        <h2>耗时最长 Top {{ top_n }} Session</h2>
        <table>
          <tr>
            <th>Session</th><th class="r">时长</th><th class="r">轮次</th>
            <th class="r">tool_use</th><th class="r">成功率</th>
            <th class="r">请求数</th><th>完成状态</th>
          </tr>
          {% for s in top_sessions %}
          <tr>
            <td><code>{{ s.session }}</code></td>
            <td class="r">{{ s.duration }}</td>
            <td class="r">{{ s.user_turns }}</td>
            <td class="r">{{ s.tool_use }}</td>
            <td class="r">{{ s.rate }}</td>
            <td class="r">{{ s.api_count }}</td>
            <td>
              {% if s.completed == 0 %}
                <span class="badge badge-ok">OK</span>
              {% else %}
                <span class="badge badge-err">{{ s.completed }}</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </table>
      </div>

    </div>

    <!-- ================================================================ -->
    <!-- TAB 2: 调用情况 -->
    <!-- ================================================================ -->
    <div class="tab-panel panel-usage">

      <div class="card">
        <h2>调用概览</h2>
        <div class="kpi-row">
          <div class="kpi"><div class="val">{{ turns.avg }}</div><div class="lbl">平均对话轮次</div></div>
          <div class="kpi"><div class="val">{{ messages.avg }}</div><div class="lbl">平均消息总数</div></div>
          <div class="kpi"><div class="val">{{ api.avg }}</div><div class="lbl">平均 API Call</div></div>
          {% if duration.has_multi %}
          <div class="kpi"><div class="val">{{ duration.avg }}</div><div class="lbl">平均耗时</div></div>
          {% endif %}
        </div>
      </div>

      <div class="two-col">
        <div>
          <div class="card">
            <h2>对话轮次分布</h2>
            {{ dist_table(turns.dist) }}
          </div>
          <div class="card">
            <h2>消息总数分布</h2>
            {{ dist_table(messages.dist) }}
          </div>
        </div>
        <div>
          <div class="card">
            <h2>API Call 次数分布</h2>
            {{ dist_table(api.dist) }}
          </div>
          {% if duration.has_multi %}
          <div class="card">
            <h2>耗时分布（多轮 session）</h2>
            {{ dist_table(duration.dist) }}
          </div>
          {% endif %}
        </div>
      </div>

    </div>

    <!-- ================================================================ -->
    <!-- TAB 3: 模型工具 -->
    <!-- ================================================================ -->
    <div class="tab-panel panel-tools">

      {% if tools.has_sessions %}
      <div class="card">
        <h2>工具调用概览</h2>
        <div class="kpi-row">
          <div class="kpi"><div class="val">{{ tools.with_count }}</div><div class="lbl">有工具 session（{{ tools.with_pct }}%）</div></div>
          <div class="kpi"><div class="val">{{ tools.total_use }}</div><div class="lbl">tool_use 总次数</div></div>
          <div class="kpi"><div class="val">{{ tools.total_result }}</div><div class="lbl">tool_result 总次数</div></div>
          {% if tools.has_results %}
          <div class="kpi"><div class="val">{{ tools.overall_rate }}%</div><div class="lbl">整体工具成功率</div></div>
          {% endif %}
        </div>

        {% if tools.has_results %}
        <h3>成功率明细</h3>
        <table>
          <tr><th>判断方式</th><th class="r">次数</th><th class="r">占比</th></tr>
          <tr><td>成功（无 flag + 无错误关键字）</td><td class="r">{{ tools.total_succ }}</td><td class="r">{{ tools.succ_pct }}%</td></tr>
          <tr><td>失败：is_error=True</td><td class="r">{{ tools.total_ff }}</td><td class="r">{{ tools.ff_pct }}%</td></tr>
          <tr><td>失败：内容含错误关键字</td><td class="r">{{ tools.total_fk }}</td><td class="r">{{ tools.fk_pct }}%</td></tr>
          <tr><td><strong>失败合计</strong></td><td class="r"><strong>{{ tools.total_ft }}</strong></td><td class="r"><strong>{{ tools.ft_pct }}%</strong></td></tr>
        </table>
        {% endif %}
      </div>
      {% endif %}

      {# Only use two-col when there's enough content for both sides #}
      {% if tools.has_sessions or tools_top10 %}
      <div class="two-col">
        <div>
          {% if tools.has_sessions %}
          <div class="card">
            <h2>tool_use 次数分布</h2>
            {{ dist_table(tools.use_dist) }}
          </div>
          {% endif %}

          {% if tools.rate_sessions_count > 0 %}
          <div class="card">
            <h2>工具成功率分布</h2>
            {{ dist_table(tools.rate_dist) }}
          </div>
          {% endif %}
        </div>

        <div>
          <div class="card">
            <h2>模型使用分布</h2>
            <table>
              <tr><th>模型</th><th class="r">数量</th><th class="r">占比</th><th style="min-width:140px">分布</th></tr>
              {% for m in models %}
              <tr>
                <td><code>{{ m.name }}</code></td>
                <td class="r">{{ m.count }}</td>
                <td class="r">{{ m.pct }}%</td>
                <td><div class="bar-cell">
                  <div class="bar-wrap"><div class="bar-fill" style="width:{{ m.pct }}%"></div></div>
                  <span class="bar-pct">{{ m.pct }}%</span>
                </div></td>
              </tr>
              {% endfor %}
            </table>
          </div>

          {% if tools_top10 %}
          <div class="card">
            <h2>Top 10 工具调用</h2>
            <table>
              <tr><th>工具名称</th><th class="r">调用</th><th class="r">成功</th><th class="r">失败</th><th class="r">成功率</th></tr>
              {% for t in tools_top10 %}
              <tr>
                <td><code>{{ t.name }}</code></td>
                <td class="r">{{ t.calls }}</td>
                <td class="r">{{ t.success }}</td>
                <td class="r">{{ t.fail }}</td>
                <td class="r">{{ t.rate }}%</td>
              </tr>
              {% endfor %}
            </table>
          </div>
          {% endif %}
        </div>
      </div>
      {% else %}
      {# No tools at all — just show model distribution full-width #}
      <div class="card">
        <h2>模型使用分布</h2>
        <table>
          <tr><th>模型</th><th class="r">数量</th><th class="r">占比</th><th style="min-width:140px">分布</th></tr>
          {% for m in models %}
          <tr>
            <td><code>{{ m.name }}</code></td>
            <td class="r">{{ m.count }}</td>
            <td class="r">{{ m.pct }}%</td>
            <td><div class="bar-cell">
              <div class="bar-wrap"><div class="bar-fill" style="width:{{ m.pct }}%"></div></div>
              <span class="bar-pct">{{ m.pct }}%</span>
            </div></td>
          </tr>
          {% endfor %}
        </table>
      </div>
      {% endif %}

      {% if skills.has_skills %}
      <div class="card">
        <h2>自定义技能统计</h2>
        <div class="kpi-row" style="margin-bottom:12px">
          <div class="kpi"><div class="val">{{ skills.distinct_count }}</div><div class="lbl">技能种类</div></div>
          <div class="kpi"><div class="val">{{ skills.total_use }}</div><div class="lbl">总调用次数</div></div>
        </div>
        <table>
          <tr><th>技能名称</th><th class="r">调用次数</th><th class="r">占比</th><th style="min-width:140px">分布</th></tr>
          {% for s in skills.top10 %}
          <tr>
            <td><code>{{ s.name }}</code></td>
            <td class="r">{{ s.count }}</td>
            <td class="r">{{ s.pct }}%</td>
            <td><div class="bar-cell">
              <div class="bar-wrap"><div class="bar-fill" style="width:{{ s.pct }}%"></div></div>
              <span class="bar-pct">{{ s.pct }}%</span>
            </div></td>
          </tr>
          {% endfor %}
        </table>
      </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
function toggleDetail(row) {
  var next = row.nextElementSibling;
  if (next && next.classList.contains('detail-row')) {
    next.classList.toggle('open');
  }
}
</script>
</body>
</html>
