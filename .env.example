# 转发前的地址
UPSTREAM_URL=https://yibuapi.com/v1  # 后缀写到v1
UPSTREAM_API_KEY="填入AK"  # 上游服务密钥
MODEL_ID=

# 客户端验证（可选）
# 客户端调用本代理时的验证密钥，不设置则不进行验证（也支持数据库管理 key）
ENABLE_KEY_ACCESS=true
API_KEY=

# 转发后的地址
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# 日志路径（绝对路径，权威来源；设置后不再依赖 LOG_TASK_TAG/PROXY_PORT/UPSTREAM_API_KEY 推导）
# LOG_DIR: 服务实例目录（export/session/backup 等 DB 落在此处）
LOG_DIR=/root/llm-proxy-main/logs/port8084/env-99oR
# DATA_DIR: 日志数据 base 目录（env 根目录）
DATA_DIR=/root/llm-proxy-main/logs_all/env-99oR

# 其他参数
SSL_VERIFY=false
BAN_EXPLORE=false
BAN_STREAM=false

# 代理相关
TRUST_ENV=true  # 为true时使用下面全局环境变量，密码特殊字符记得转码
HTTP_PROXY=http://账号:密码@proxyhk.xx.com:8080
HTTPS_PROXY=http://账号:密码@proxyhk.xx.com:8080
NO_PROXY=localhost,127.0.0.1,*.local,*.lan,10.70.85.106

# 监控界面登录
MONITOR_USERNAME=root
MONITOR_PASSWORD=hw123456
MONITOR_SESSION_SECRET=5804b8aa-33f6-11f1-a791-00155d57fecb
MONITOR_COOKIE_SECURE=false
MONITOR_SESSION_MAX_AGE=43200